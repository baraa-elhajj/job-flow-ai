PORT=4000
FRONTEND_URL=http://localhost:5173
SQLITE_DB_PATH=./data/jobs.db

# Meilisearch (local native binary — start with `npm run meili` from repo root)
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=dev-master-key-change-me

# Scraper API — used by GitHub Actions to POST scraped jobs to your server
# SCRAPER_API_URL=https://your-server.example.com/api/scraper
# SCRAPER_API_KEY=generate-with-openssl-rand-base64-32

# MongoDB — only needed for one-time migration to SQLite
# MONGO_URI=mongodb://localhost:27017/jobflow
# MONGODB_URI=mongodb+srv://...
# MONGO_COLLECTIONS=jobs,Jobs
# MONGO_EXTRA_SOURCES=test.jobs

# Optional scraper settings (Python LinkedIn/Bayt samples and GitHub Actions)
# SCRAPE_LIMIT=50
# BYPARR_URL=http://localhost:8191
# BYPARR_TIMEOUT_MS=120000
# BAYT_SEARCH_URL=https://www.bayt.com/en/international/jobs/information-technology-jobs/?filters[jb_last_modification_date_interval][]=3&options[sort][]=d
# PROXY=host:port:username:password
# PROXY_LIST=host:port:user:pass|host:port:user:pass   # fallback proxies on retry

# DeepSeek API (optional, for HN job parsing)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Google OAuth — must match VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Session JWT signing secret (generate: openssl rand -base64 32)
JWT_SECRET=change-me-to-a-long-random-string
